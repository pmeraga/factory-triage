{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": ".vercel-public",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "dist/server/index.js",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index?__factory_triage_path=/$1"
    }
  ]
}
